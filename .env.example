# RDC Checker settings. Copy to .env (or use the Settings tab in the UI).
# .env is git-ignored. NEVER commit real values; share them privately.

# --- Sheet connection
# Link to the QA Google Sheet (only used for the "Open sheet" button).
SHEET_URL=
# Apps Script web app URL (Deploy > Manage deployments > Web app URL, ends in /exec).
SHEET_WEBAPP_URL=
# Same value as the QA_TOKEN Script Property in the sheet's Apps Script.
SHEET_TOKEN=
# Name written in the Check Log. Add the same name to the sheet's Team tab.
CHECKER_NAME=RDC QA Bot

# --- App addresses (base URL, no trailing slash)
# The deployment under test.
APP_URL_VERCEL=https://evims.vercel.app
# The original WordPress site. Parity tests (PAR-...) also sign in here and compare it with Vercel; read only.
APP_URL_ORIGINAL=https://evims.rdc8ims.online

# --- Test accounts: username:password (Member Portal sign-in; imported WordPress accounts work)
# Leave empty if you have no account for that role; tests needing it are reported Blocked.
# Use the dev_* test accounts listed on the sheet's Roles & Access tab; never commit their password.
# One per role in src/catalog.js ROLE_INFO (Vercel test usernames: test_rdc_*, newtest_agency_*).
ACCOUNT_ADMIN=
ACCOUNT_MEMBER=
ACCOUNT_RDC_CHECKER=
ACCOUNT_RDC_ENCODER=
ACCOUNT_RDC_MEMBER=
ACCOUNT_APPROVING_OFFICER=
ACCOUNT_AGENCY_ADMIN=
ACCOUNT_AGENCY_HEAD=
ACCOUNT_AGENCY_CHECKER=
ACCOUNT_AGENCY_ENCODER=
ACCOUNT_AGENCY_GUEST=
ACCOUNT_PSR=
ACCOUNT_CSO=
ACCOUNT_RIATF=
ACCOUNT_DBM_REVIEWER=
ACCOUNT_CHED_REVIEWER=
ACCOUNT_CHIEF_REVIEWER=
ACCOUNT_CHED_CHIEF_REVIEWER=
ACCOUNT_NEDA_CHIEF_REVIEWER=
# An account that must be REFUSED at sign-in (wrong password is fine: user:wrongpass).
ACCOUNT_INVALID=

# --- Original-site accounts for parity tests (Settings > Original-site accounts > "Use different accounts").
# true = the original site has its own accounts: only the ORIGINAL_ACCOUNT_<ROLE> below are used there.
# false = an empty ORIGINAL_ACCOUNT_<ROLE> falls back to the ACCOUNT_<ROLE> above.
ORIGINAL_SEPARATE_ACCOUNTS=true
# Original-site test usernames: dev_rdc_* (see the sheet's Roles & Access tab).
ORIGINAL_ACCOUNT_ADMIN=
ORIGINAL_ACCOUNT_MEMBER=
ORIGINAL_ACCOUNT_RDC_CHECKER=
ORIGINAL_ACCOUNT_RDC_ENCODER=
ORIGINAL_ACCOUNT_RDC_MEMBER=
ORIGINAL_ACCOUNT_APPROVING_OFFICER=
ORIGINAL_ACCOUNT_AGENCY_ADMIN=
ORIGINAL_ACCOUNT_AGENCY_HEAD=
ORIGINAL_ACCOUNT_AGENCY_CHECKER=
ORIGINAL_ACCOUNT_AGENCY_ENCODER=
ORIGINAL_ACCOUNT_AGENCY_GUEST=
ORIGINAL_ACCOUNT_PSR=
ORIGINAL_ACCOUNT_CSO=
ORIGINAL_ACCOUNT_RIATF=
ORIGINAL_ACCOUNT_DBM_REVIEWER=
ORIGINAL_ACCOUNT_CHED_REVIEWER=
ORIGINAL_ACCOUNT_CHIEF_REVIEWER=
ORIGINAL_ACCOUNT_CHED_CHIEF_REVIEWER=
ORIGINAL_ACCOUNT_NEDA_CHIEF_REVIEWER=

# --- Safety
# true = allow tests that create/edit/delete real records (they clean up after themselves).
ALLOW_WRITE_TESTS=false

# --- Timing / misc
SETTLE_MS=2500
PAGE_TIMEOUT_MS=30000
# "off" disables the Windows pop-up when a run ends.
QA_NOTIFY=on
# Port for the local UI (default 4417).
QA_UI_PORT=4417
