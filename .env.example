# RDC Checker settings. Copy to .env (or use the Settings tab in the UI).
# .env is git-ignored. NEVER commit real values; share them privately.

# --- Sheet connection
# Link to the QA Google Sheet (only used for the "Open sheet" button).
SHEET_URL=
# Apps Script web app URL (Deploy > Manage deployments > Web app URL, ends in /exec).
SHEET_WEBAPP_URL=
# Same value as the QA_TOKEN Script Property in the sheet's Apps Script.
SHEET_TOKEN=
# Name written in the Check Log. Add the same name to the sheet's Team tab.
CHECKER_NAME=RDC QA Bot

# --- App addresses (base URL, no trailing slash)
# The deployment under test.
APP_URL_VERCEL=https://rdc8ims.vercel.app
# The original WordPress site. Only used as a link in reports; the checker never tests it.
APP_URL_ORIGINAL=https://evims.rdc8ims.online

# --- Test accounts: username:password (Member Portal sign-in; imported WordPress accounts work)
# Leave empty if you have no account for that role; tests needing it are reported Blocked.
ACCOUNT_ADMIN=
ACCOUNT_AGENCY=
ACCOUNT_MEMBER=
# An account that must be REFUSED at sign-in (wrong password is fine: user:wrongpass).
ACCOUNT_INVALID=

# --- Safety
# true = allow tests that create/edit/delete real records (they clean up after themselves).
ALLOW_WRITE_TESTS=false

# --- Timing / misc
SETTLE_MS=2500
PAGE_TIMEOUT_MS=30000
# "off" disables the Windows pop-up when a run ends.
QA_NOTIFY=on
# Port for the local UI (default 4417).
QA_UI_PORT=4417
