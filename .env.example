# RDC Checker settings. Copy to .env (or use the Settings tab in the UI).
# .env is git-ignored. NEVER commit real values; share them privately.

# --- Sheet connection
# Link to the QA Google Sheet (only used for the "Open sheet" button).
SHEET_URL=
# Apps Script web app URL (Deploy > Manage deployments > Web app URL, ends in /exec).
SHEET_WEBAPP_URL=
# Same value as the QA_TOKEN Script Property in the sheet's Apps Script.
SHEET_TOKEN=
# Name written in the Check Log. Add the same name to the sheet's Team tab.
CHECKER_NAME=RDC QA Bot

# --- App addresses (base URL, no trailing slash)
# The deployment under test.
APP_URL_VERCEL=https://evims.vercel.app
# The original WordPress site. Parity tests (PAR-...) also sign in here and compare it with Vercel; read only.
APP_URL_ORIGINAL=https://evims.rdc8ims.online

# --- QA accounts (npm run accounts): the same username on both sites and ONE shared password.
# QA_PASSWORD is generated the first time; never paste it in chat or commit it.
QA_PASSWORD=
# An existing RDC Admin on each site, used once to add the QA accounts (username:password).
# Empty = NEW_RDC_ADMIN / LEGACY_RDC_ADMIN.
SETUP_ADMIN_NEW=
SETUP_ADMIN_LEGACY=

# --- Test accounts: username (password = QA_PASSWORD) or username:password, one per role (src/roles.js; usernames on the sheet's Roles & Access tab).
# NEW_<ROLE> = the new app on Vercel. Empty = that role's tests are Blocked. Never commit passwords.
NEW_RDC_ADMIN=
NEW_MEMBER=
NEW_RDC_CHECKER=
NEW_RDC_ENCODER=
NEW_RDC_MEMBER=
NEW_RDC_APPROVING_OFFICER=
NEW_AGENCY_ADMIN=
NEW_AGENCY_HEAD=
NEW_AGENCY_CHECKER=
NEW_AGENCY_ENCODER=
NEW_AGENCY_GUEST=
NEW_PS_REPRESENTATIVE=
NEW_CSO_MEMBER=
NEW_RIATF_REP=
NEW_PROJECT_REVIEWER_DBM=
NEW_PROJECT_REVIEWER_CHED=
NEW_DBM_CHIEF_REVIEWER=
NEW_CHED_CHIEF_REVIEWER=
NEW_NEDA_CHIEF_REVIEWER=
NEW_PROJECT_REVIEWER_NEDA=
NEW_DBM_OFFICER=
NEW_LGU_REPRESENTATIVE=
NEW_CONGRESSIONAL_REPRESENTATIVE=
NEW_GUEST_USER=
NEW_INVESTOR=
NEW_GAD_FOCAL=
NEW_PUBLIC_USER=
NEW_DATA_UPLOADER=
NEW_ADMINISTRATOR=
# An account that must be REFUSED at sign-in (wrong password is fine: user:wrongpass).
ACCOUNT_INVALID=

# --- Legacy site accounts (the original WordPress site), for parity tests: LEGACY_<ROLE>.
# ORIGINAL_SEPARATE_ACCOUNTS=true ("Use different accounts"): only LEGACY_ accounts are used there.
# false: an empty LEGACY_<ROLE> falls back to NEW_<ROLE>.
ORIGINAL_SEPARATE_ACCOUNTS=true
LEGACY_RDC_ADMIN=
LEGACY_MEMBER=
LEGACY_RDC_CHECKER=
LEGACY_RDC_ENCODER=
LEGACY_RDC_MEMBER=
LEGACY_RDC_APPROVING_OFFICER=
LEGACY_AGENCY_ADMIN=
LEGACY_AGENCY_HEAD=
LEGACY_AGENCY_CHECKER=
LEGACY_AGENCY_ENCODER=
LEGACY_AGENCY_GUEST=
LEGACY_PS_REPRESENTATIVE=
LEGACY_CSO_MEMBER=
LEGACY_RIATF_REP=
LEGACY_PROJECT_REVIEWER_DBM=
LEGACY_PROJECT_REVIEWER_CHED=
LEGACY_DBM_CHIEF_REVIEWER=
LEGACY_CHED_CHIEF_REVIEWER=
LEGACY_NEDA_CHIEF_REVIEWER=
LEGACY_PROJECT_REVIEWER_NEDA=
LEGACY_DBM_OFFICER=
LEGACY_LGU_REPRESENTATIVE=
LEGACY_CONGRESSIONAL_REPRESENTATIVE=
LEGACY_GUEST_USER=
LEGACY_INVESTOR=
LEGACY_GAD_FOCAL=
LEGACY_PUBLIC_USER=
LEGACY_DATA_UPLOADER=

# --- Safety
# true = allow tests that create/edit/delete real records (they clean up after themselves).
ALLOW_WRITE_TESTS=false

# --- Timing / misc
SETTLE_MS=2500
PAGE_TIMEOUT_MS=30000
# "off" disables the Windows pop-up when a run ends.
QA_NOTIFY=on
# Port for the local UI (default 4417).
QA_UI_PORT=4417
